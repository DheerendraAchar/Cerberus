FROM pytorch/pytorch:2.0-cuda11.8-runtime-ubuntu22.04

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# Copy project
COPY . .

# Install cerberus in editable mode
RUN pip install --no-cache-dir -e .

# Create directories for data and models
RUN mkdir -p /app/data /app/models /app/results

# Set environment variables
ENV PYTHONUNBUFFERED=1
ENV CERBERUS_DATA_DIR=/app/data
ENV CERBERUS_MODEL_DIR=/app/models
ENV CERBERUS_RESULT_DIR=/app/results

# Default command
CMD ["python", "-c", "import cerberus; print(f'Cerberus {cerberus.__version__} ready')"]
